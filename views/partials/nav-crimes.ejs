<!-- Navegação entre Tipos de Crime -->
<section class="border-top py-2" aria-label="Indicador de crime exibido">
    <div class="d-flex flex-wrap gap-2">
        <% (itensNavegacao || []).forEach(function (item) {
            const ativo = (typeof crimeAtual !== 'undefined' && crimeAtual === item.slug);
        %>
            <a href="<%= item.href %>"
               class="btn rounded-0 <%= ativo ? 'btn-light fw-semibold' : 'btn-outline-secondary' %>"
               <%= ativo ? 'aria-current="page"' : '' %>><%= item.nome %></a>
        <% }); %>
    </div>
</section>
